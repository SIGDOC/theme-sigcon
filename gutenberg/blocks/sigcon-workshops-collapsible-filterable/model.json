{
  "block_meta": {
    "apiVersion": 3,
    "BLOCK_REGISTER_NAME": "sigcon-workshops-collapsible-filterable",
    "BLOCK_TITLE": "SIGCON Workshops: Flexible, Collapsible, Filterable",
    "keywords": ["flexible", "collapsible", "filterable", "cards", "workshops"],
    "hasSidebar": false,
    "hasExample": true,
    "deps": {
      "css": ["sigcon-cards"],
      "js": ["jquery-1.7.1.min"]
    }
  },

  "attributes": {
    "cards": {
      "type": "array",
      "field_meta": {
        "type": "repeater",
        "label": "Create New Workshop Cards",
        "grid": 2,
        "subfields": {
          "workshop_title": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "label": "Workshop Title (h3)"
            },
            "default": {
              "text": ""
            }
          },
          "facilitators": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "variation":"long",
              "label": "Facilitator Names (Affiliation)",
              "help": "Add the facilitator names (affiliation) as a comma-separated list. Content is wrapped in paragraph element."
            },
            "default": {
              "text": ""
            }
          },
          "description": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "variation": "long",
              "label": "Enter the workshop description. Content is wrapped in paragraph element."
            },
            "default": {
              "text": ""
            }
          },
          "structure_format": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "variation": "long",
              "label": "Enter Workshop Structure and Format. Content is wrapped in paragraph element.",
              "help": "Enter the workshop structure and format."
            },
            "default": {
              "text": ""
            }
          }
        }
      },
      "default": []
    }
  },

  "supports": {
    "html": false
  }
}
