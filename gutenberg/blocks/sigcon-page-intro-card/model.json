{
  "block_meta": {
    "apiVersion": 3,
    "BLOCK_REGISTER_NAME": "sigcon-page-intro-card",
    "BLOCK_TITLE": "SIGDOC Conference Introductory Card for a Page",
    "keywords": ["cards", "preface", "introductory"],
    "hasSidebar": false,
    "hasExample": true
  },

  "attributes": {
    "aria_label": {
      "type": "object",
      "field_meta": {
        "type": "text",
        "label": "ARIA Label for the Introductory Panel Content Area",
        "help":" This is important for accessibility. Provide a short description of this section's topic."
      },
      "default": {
        "text": ""
      }
    },
    "main_content": {
      "type": "array",
      "field_meta": {
        "type": "repeater",
        "label": "Create Paragraphs",
        "grid": 2,
        "subfields": {
          "main_paragraph": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "variation": "long",
              "help": "This is a long text field wrapped in a single paragraph element. It populates the intro content before the Quick Links below it. Keep it brief.",
              "label": "Text wrapped in single paragraph element"
            },
            "default": {
              "text": "Add introductory text here."
            }
          }
        }
      },
      "default": []
    },
    "quick_links": {
      "type": "array",
      "field_meta": {
        "type": "repeater",
        "label": "Create Quick Links",
        "grid": 2,
        "subfields": {
          "link_text": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "label": "Link Text"
            },
            "default": {
              "text": ""
            }
          },
          "quick_link": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "label": "Link to page (URL)",
              "help": "Provide full URL to the page."
            },
            "default": {
              "text": "https://..."
            }
          }
        }
      },
      "default": []
    }
  },

  "supports": {
    "html": false
  }
}
