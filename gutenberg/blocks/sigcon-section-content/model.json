{
  "block_meta": {
    "apiVersion": 3,
    "BLOCK_REGISTER_NAME": "sigcon-section-content",
    "BLOCK_TITLE": "SIGDOC Conference Page Template",
    "keywords": ["main content", "sections"],
    "hasSidebar": true,
    "hasExample": true
  },

  "attributes": {
    "main_heading": {
      "type": "object",
      "field_meta": {
        "type": "text",
        "label": "Heading for the Section"
      },
      "default": {
        "text": ""
      }
    },
    "main_content": {
      "type": "object",
      "field_meta": {
        "type": "freeform",
        "label": "Enter Section Content with the (Classic Editor). WARNING! You will need to update this section upon each content update, due to Gutenberg APIv3 iframe issues.",
        "help": "This is a content field for the main content area",
        "editorStyle": "wp-block-freeform-editor"
      },
      "default": {
        "text": ""
      }
    }
  },

  "supports": {
    "html": false,
    "ariaLabel": true
  }
}
