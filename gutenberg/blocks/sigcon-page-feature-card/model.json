{
  "block_meta": {
    "apiVersion": 3,
    "BLOCK_REGISTER_NAME": "sigcon-page-feature-card",
    "BLOCK_TITLE": "SIGDOC Feature Card with List of Links",
    "keywords": ["cards", "preface", "introductory", "feature"],
    "hasSidebar": false,
    "hasExample": true
  },

  "attributes": {
    "aria_label": {
      "type": "object",
      "field_meta": {
        "type": "text",
        "label": "ARIA Label for the Feature Panel Content Area",
        "help": " This is important for accessibility. Provide a short description of this section's topic."
      },
      "default": {
        "text": ""
      }
    },
    "main_content": {
      "type": "object",
      "field_meta": {
        "type": "freeform",
        "help": "This is a rich-text content field for the content before the quick links list. Keep it brief."
      },
      "default": {
        "text": ""
      }
    },
    "links_heading": {
      "type": "object",
      "field_meta": {
        "type": "text",
        "label": "Heading for the Links"
      },
      "default": {
        "text": ""
      }
    },
    "quick_links": {
      "type": "array",
      "field_meta": {
        "type": "repeater",
        "label": "Create Quick Links",
        "grid": 2,
        "subfields": {
          "link_text": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "label": "Link Text"
            },
            "default": {
              "text": ""
            }
          },
          "quick_link": {
            "type": "object",
            "field_meta": {
              "type": "text",
              "label": "Link to page (URL)",
              "help": "Provide full URL to the page."
            },
            "default": {
              "text": "https://..."
            }
          }
        }
      },
      "default": []
    }
  },

  "supports": {
    "html": false
  }
}
