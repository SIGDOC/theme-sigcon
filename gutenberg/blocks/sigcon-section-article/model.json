{
  "block_meta": {
    "apiVersion": 3,
    "BLOCK_REGISTER_NAME": "sigcon-section-content",
    "BLOCK_TITLE": "SIGDOC Articles Template",
    "keywords": ["main content", "sections", "articles"],
    "hasSidebar": true,
    "hasExample": true
  },

  "attributes": {
    "main_heading": {
      "type": "object",
      "field_meta": {
        "type": "text",
        "label": "Heading for the Section"
      },
      "default": {
        "text": ""
      }
    },
    "main_content": {
      "type": "object",
      "field_meta": {
        "type": "freeform",
        "label": "Enter Section Content with the (Classic Editor).",
        "help": "This is a content field for the main content area",
        "editorStyle": "wp-block-freeform-editor"
      },
      "default": {
        "text": "Enter your content here."
      }
    }
  },

  "supports": {
    "html": false,
    "ariaLabel": true
  }
}
